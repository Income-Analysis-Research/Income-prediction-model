# Models (large files - do NOT commit to git)
models/**/*.pkl
models/**/*.joblib
models/**/*.h5
models/**/*.pt
models/**/*.pth

# But keep the directory structure
!models/us/.gitkeep
!models/india/.gitkeep

# Datasets folder (centralized - do NOT commit)
datasets/**/*.csv
datasets/**/*.xlsx
datasets/**/*.json
datasets/**/*.parquet
datasets/**/*.zip
datasets/**/*.gz
datasets/*.csv
datasets/*.xlsx

# Keep README in datasets folder
!datasets/README.md

# Processed data (can be regenerated)
data_processed/**/*.csv
data_processed/**/*.parquet

# Raw data (legacy - do NOT commit - download separately)
data_raw/**/*.csv
data_raw/**/*.xlsx
data_raw/**/*.json
data_raw/**/*.parquet
data_raw/**/*.zip
data_raw/**/*.gz

# Keep .gitkeep files
!**/.gitkeep

# Environment variables
.env
.env.local

# IDE
